{
  "name": "koinsight",
  "version": "0.2.2",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "rm -rf apps/web/dist && mkdir apps/web/dist",
    "build:web": "cd apps/web && bun run build",
    "test:coverage": "turbo run test:coverage",
    "dev:web": "cd apps/web && bun dev",
    "dev:server:wrangler": "wrangler pages dev --proxy 3000",
    "dev:server:netlify": "netlify dev",
    "dev:wrangler": "bun clean && concurrently 'bun dev:web' 'bun dev:server:wrangler'",
    "dev:netlify": "bun clean && concurrently 'bun dev:web' 'bun dev:server:netlify'",
    "dev:bun": "bun run --watch apps/server/src/index.bun.ts",
    "lint": "oxlint --type-aware .",
    "format": "prettier -w .",
    "push:env": "wrangler secret bulk .env",
    "deploy:wrangler": "bun lint && bun typecheck && bun build:web && bun push:env && wrangler deploy",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "3.6.2",
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "wrangler": "^4.77.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.9"
}

    "postgres": "^3.4.8",
    "ramda": "0.31.1",
    "sql.js": "^1.14.1",
    "webdav": "^5.9.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@faker-js/faker": "10.2.0",
